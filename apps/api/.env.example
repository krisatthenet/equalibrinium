# Node.js server environment variables
NODE_ENV=production

# Port is set automatically by the host — leave this commented out
# PORT=3001

# PocketBase URL
POCKETBASE_URL=https://your-pocketbase.railway.app

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PocketBase admin credentials (used by the API server for privileged operations)
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Stripe (payments + subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe subscription price IDs — run: node scripts/setup-stripe-products.js
STRIPE_PRICE_CONTRACTOR_VIP_MONTHLY=
STRIPE_PRICE_CONTRACTOR_VIP_YEARLY=
STRIPE_PRICE_CONTRACTOR_ELITE_MONTHLY=
STRIPE_PRICE_CONTRACTOR_ELITE_YEARLY=
STRIPE_PRICE_CONTRACTOR_PREMIUM_MONTHLY=
STRIPE_PRICE_CONTRACTOR_PREMIUM_YEARLY=
STRIPE_PRICE_CONTRACTOR_ULTRA_MONTHLY=
STRIPE_PRICE_CONTRACTOR_ULTRA_YEARLY=
STRIPE_PRICE_CLIENT_VIP_MONTHLY=
STRIPE_PRICE_CLIENT_VIP_YEARLY=
STRIPE_PRICE_CLIENT_ELITE_MONTHLY=
STRIPE_PRICE_CLIENT_ELITE_YEARLY=
STRIPE_PRICE_CLIENT_PREMIUM_MONTHLY=
STRIPE_PRICE_CLIENT_PREMIUM_YEARLY=
STRIPE_PRICE_CLIENT_ULTRA_MONTHLY=
STRIPE_PRICE_CLIENT_ULTRA_YEARLY=

# Google reCAPTCHA Enterprise (used for contact form)
GOOGLE_RECAPTCHA_API_KEY=

# JWT
JWT_SECRET=
