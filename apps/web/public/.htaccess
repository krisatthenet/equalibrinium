Options -MultiViews

# Allow social media scrapers through any bot protection
SetEnvIfNoCase User-Agent "facebookexternalhit" social_bot
SetEnvIfNoCase User-Agent "Twitterbot" social_bot
SetEnvIfNoCase User-Agent "LinkedInBot" social_bot
SetEnvIfNoCase User-Agent "Slackbot" social_bot
SetEnvIfNoCase User-Agent "WhatsApp" social_bot

Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google.com https://www.gstatic.com https://maps.googleapis.com https://ajax.googleapis.com https://cdn-reach.hostinger.com https://snap.licdn.com https://platform.linkedin.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://ep1.adtrafficquality.google https://fundingchoicesmessages.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob: https://px.ads.linkedin.com; connect-src 'self' https://*.railway.app https://*.up.railway.app https://*.workbee.space https://ipapi.co https://www.google.com https://*.google.com https://maps.googleapis.com https://maps.gstatic.com https://www.linkedin.com https://px.ads.linkedin.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://ep1.adtrafficquality.google https://region1.google-analytics.com; frame-src https://www.google.com https://recaptcha.google.com https://googleads.g.doubleclick.net https://fundingchoicesmessages.google.com; object-src 'none'; upgrade-insecure-requests"

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
