# Production env vars — baked into the frontend bundle at build time
# Set this to your Railway PocketBase public URL
VITE_POCKETBASE_URL=https://your-pocketbase.railway.app

# Optional: override the Google Maps API key
# VITE_GOOGLE_MAPS_API_KEY=

# Optional: override reCAPTCHA site key
# VITE_RECAPTCHA_SITE_KEY=
